---
// Body text: Ubuntu 400, 14px, 16px from sm. The look is the text-p1 class; `as` sets the tag, so the tag can follow the meaning.
import type { HTMLAttributes } from "astro/types";
import "./typography.css";

type Props = HTMLAttributes<"p"> & { as?: string };

const { as: Tag = "p", class: extra, ...rest } = Astro.props;
---

<Tag class:list={["text-p1", extra]} {...rest}><slot /></Tag>
