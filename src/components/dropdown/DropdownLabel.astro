---
import type { HTMLAttributes } from "astro/types";
import { cva } from "class-variance-authority";
import { cn } from "#/core/cn";

type Props = HTMLAttributes<"div"> & {
  /**
   * Whether the label is inset (has left padding)
   */
  inset?: boolean;
};

const dropdownLabel = cva("px-2 py-1.5 font-semibold", {
  variants: {
    inset: {
      true: "pl-8",
    },
  },
  defaultVariants: {
    inset: false,
  },
});

const { class: className, inset = false, ...rest } = Astro.props;
---

<div class={cn(dropdownLabel({ inset }), className)} data-slot="dropdown-label" {...rest}>
  <slot />
</div>
