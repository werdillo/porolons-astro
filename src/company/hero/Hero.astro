---
import { Image } from "astro:assets";
import { Container } from "#/components/container";
import { H1, H5 } from "#/components/typography";
import type { Language } from "#/features/i18n";
import { heroData } from "./data";
import heroImage from "./hero.jpg";

const { lang } = Astro.props as { lang: Language };
---

<section
    id="hero"
    aria-labelledby="hero-title"
    class="relative w-full h-[300px] sm:h-[60vh] grid place-items-center overflow-hidden"
>
    <Image
        src={heroImage}
        alt={heroData.imageAlt[lang]}
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 w-full h-full object-cover object-bottom"
    />
    <Container class="relative">
        <div class="bg-overlay p-5 rounded-[5px] backdrop-blur-[2px]">
            <H1 id="hero-title" class="text-on-dark my-2.5 sm:my-5">
                {heroData.title1[lang]}
                <br />
                {heroData.title2[lang]}
            </H1>
            <H5 as="p" class="text-on-dark mt-2.5 sm:mt-5 mb-0">{heroData.text[lang]}</H5>
        </div>
    </Container>
</section>
