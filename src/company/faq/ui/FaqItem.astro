---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { AccordionItem, AccordionTrigger, AccordionContent } from "#/components/accordion";
import { H4, P2 } from "#/components/typography";

interface Props {
    value: string;
    image: ImageMetadata;
    title: string;
    body: string;
}

const { value, image, title, body } = Astro.props;
---

<AccordionItem value={value}>
    <AccordionTrigger class="px-3 md:px-6">
        <span class="flex items-center md:py-2 gap-4 md:gap-6 flex-1 text-body">
            <Image
                src={image}
                alt=""
                width={56}
                height={56}
                loading="lazy"
                class="shrink-0 w-[35px] h-[35px] md:w-14 md:h-14"
            />
            <H4 as="span" class="text-body text-left">{title}</H4>
        </span>
    </AccordionTrigger>
    <AccordionContent class="px-3 md:px-6 text-body">
        <P2 class="py-3">{body}</P2>
    </AccordionContent>
</AccordionItem>
