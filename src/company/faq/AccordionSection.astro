---
import { Image } from "astro:assets";
import { Accordion, AccordionItem, AccordionTrigger, AccordionContent } from "#/components/accordion";
import { Container } from "#/components/container";
import { Section } from "#/components/section";
import type { Language } from "#/features/i18n";
import { accordionData } from "./data";

const { lang } = Astro.props as { lang: Language };
---

<Section spacing="loose">
    <Container size="narrow">
        <div class="text-center mb-6 md:mb-10">
            <h1 class="text-section md:text-5xl text-body font-medium">
                {accordionData.title[lang]}
            </h1>
        </div>

        <Accordion type="single">
            {
                accordionData.items.map((item) => (
                    <AccordionItem value={item.id}>
                        <AccordionTrigger class="px-3 md:px-6">
                            <div class="flex items-center md:py-2 gap-4 md:gap-6 flex-1 text-body">
                                <Image
                                    src={item.image}
                                    alt={item[`title_${lang}` as const]}
                                    width={56}
                                    height={56}
                                    class="shrink-0 w-[35px] h-[35px] md:w-14 md:h-14"
                                />
                                <span class="text-body font-normal md:text-2xl text-left">
                                    {item[`title_${lang}` as const]}
                                </span>
                            </div>
                        </AccordionTrigger>
                        <AccordionContent class="px-3 md:px-6 text-body">
                            <p class="text-sm py-3 md:text-xl font-light leading-relaxed">
                                {item[`body_${lang}` as const]}
                            </p>
                        </AccordionContent>
                    </AccordionItem>
                ))
            }
        </Accordion>
    </Container>
</Section>
