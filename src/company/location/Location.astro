---
import { Image } from "astro:assets";
import { Container } from "#/components/container";
import { Section } from "#/components/section";
import type { Language } from "#/features/i18n";
import { locationData } from "./data";
import mapPicture from "./assets/map.png";
import Union from "./assets/Union.svg";

const { lang } = Astro.props as { lang: Language };
---

<Section tone="dark" id="location">
    <Container>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-[30px]">
            <div class="text-white">
                <h3
                    class="font-medium text-section sm:text-section-sm md:text-section-md leading-8 sm:leading-[45px] tracking-title mb-5 sm:mb-[30px] md:mb-[50px] text-center md:text-left"
                >
                    {locationData.title[lang]}
                </h3>

                <div class="contact-gap">
                    <p class="contact-text">
                        <i class="fa fa-envelope mr-2.5 sm:mr-5 contact-icon"></i>
                        <a href={`mailto:${locationData.contact.email}`} class="contact-link">
                            {locationData.contact.email}
                        </a>
                    </p>
                    <p class="contact-text">
                        <i class="fa fa-phone mr-2.5 sm:mr-5 contact-icon"></i>
                        <a href={`tel:+371${locationData.contact.phone1}`} class="contact-link">
                            {locationData.contact.phone1}
                        </a>,
                        <a href={`tel:+371${locationData.contact.phone2}`} class="contact-link">
                            {locationData.contact.phone2}
                        </a>
                    </p>
                </div>

                <div class="contact-gap flex items-start">
                    <i class="fa fa-map-marker-alt mr-3.5 shrink-0 contact-icon"></i>
                    <p class="contact-text">
                        <a
                            href={`https://maps.google.com/?q=${locationData.contact.address}`}
                            target="_blank"
                            class="contact-link"
                        >
                            {locationData.contact.address}
                        </a>
                    </p>
                </div>

                <div class="ml-2.5 sm:ml-5 md:ml-10">
                    {
                        (["weekday", "break", "weekend"] as const).map((key) => (
                            <p class="contact-text">
                                {locationData.workingHours[`${key}_${lang}` as const]}
                            </p>
                        ))
                    }
                </div>
            </div>

            <div class="w-full flex justify-center">
                <iframe
                    src={locationData.mapUrl}
                    class="map-frame max-w-[500px] border-0"
                    allowfullscreen=""
                    aria-hidden="false"
                    tabindex="0"></iframe>
            </div>

            <div class="w-full overflow-hidden">
                <Image src={mapPicture} alt="Location map" class="map-frame object-cover block" />
            </div>

            <div class="flex items-center">
                <div class="py-0 md:py-[30px]">
                    {
                        locationData.mapPoints[lang].map((point) => (
                            <p class="text-white my-0.5 text-xs sm:text-sm md:text-lg leading-6 sm:leading-7 md:leading-9">
                                {point}
                            </p>
                        ))
                    }
                </div>
            </div>

            <div class="col-span-1 md:col-span-2 mt-[15px] md:mt-[30px] hidden sm:block">
                <a href="/map.png" target="_blank" class="dim-on-hover no-underline inline-flex items-center">
                    <Image src={Union} alt="" class="mr-[30px]" />
                    <h6
                        class="text-white text-xs sm:text-sm md:text-lg leading-6 sm:leading-7 md:leading-9 tracking-text m-0 flex items-center font-normal"
                    >
                        {locationData.scheme[lang]}
                    </h6>
                </a>
            </div>
        </div>
    </Container>
</Section>
