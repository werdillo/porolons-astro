---
import { Container } from "#/components/container";
import { Section } from "#/components/section";
import { H2 } from "#/components/typography";
import type { Language } from "#/features/i18n";
import { productionData } from "../data";
import ProductionItem from "./ProductionItem.astro";

const { lang } = Astro.props as { lang: Language };
---

<Section tone="surface" id="photos" aria-labelledby="production-title">
    <Container>
        <H2 id="production-title" class="text-center text-body mb-[30px] sm:mb-10 md:mb-20">
            {productionData.title[lang]}
        </H2>
        <ul class="grid grid-cols-2 md:grid-cols-4 gap-x-[15px] gap-y-[30px] sm:gap-x-5 sm:gap-y-10 md:gap-x-[30px] md:gap-y-[60px] w-full">
            {productionData.items.map((item) => <ProductionItem image={item.image} text={item[`text_${lang}` as const]} />)}
        </ul>
    </Container>
</Section>
