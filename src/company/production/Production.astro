---
import { Image } from "astro:assets";
import { Container } from "#/components/container";
import { Section } from "#/components/section";
import type { Language } from "#/features/i18n";
import { productionData } from "./data";

const { lang } = Astro.props as { lang: Language };
---

<Section tone="surface" id="photos">
    <Container>
        <h1 class="section-title text-body leading-[1.3] md:leading-none">
            {productionData.title[lang]}
        </h1>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-x-[15px] gap-y-[30px] sm:gap-x-5 sm:gap-y-10 md:gap-x-[30px] md:gap-y-[60px] w-full">
            {
                productionData.items.map((item) => (
                    <div class="text-center min-w-0 overflow-hidden">
                        <Image
                            src={item.image}
                            alt={item[`text_${lang}` as const]}
                            class="w-full max-w-full h-auto mb-4 block object-contain"
                        />
                        <p class="text-[13px] sm:text-base md:text-xl font-medium leading-normal sm:leading-[22px] md:leading-[1.3] tracking-[0.005em] text-body m-0">
                            {item[`text_${lang}` as const]}
                        </p>
                    </div>
                ))
            }
        </div>
    </Container>
</Section>
