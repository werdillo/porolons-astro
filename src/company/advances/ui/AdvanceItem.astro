---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { P1 } from "#/components/typography";

interface Props {
    icon: ImageMetadata;
    text: string;
}

const { icon, text } = Astro.props;
---

<li class="flex sm:flex-col items-center text-left sm:text-center gap-4 sm:gap-0">
    <Image
        src={icon}
        alt=""
        width={70}
        height={70}
        loading="lazy"
        class="w-[50px] h-[50px] sm:w-[70px] sm:h-[70px] shrink-0 sm:mb-5"
    />
    <P1 class="text-soft m-0">{text}</P1>
</li>
