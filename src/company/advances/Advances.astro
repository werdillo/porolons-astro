---
import { Image } from "astro:assets";
import { Container } from "#/components/container";
import { Section } from "#/components/section";
import type { Language } from "#/features/i18n";
import { advancesData } from "./data";

const { lang } = Astro.props as { lang: Language };
---

<Section id="content">
    <Container>
        <h1 class="section-title text-body leading-[1.4]">
            {advancesData.title[lang]}
        </h1>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-5 sm:gap-[30px] md:gap-[50px]">
            {
                advancesData.items.map((item) => (
                    <div class="flex sm:flex-col items-center text-left sm:text-center gap-4 sm:gap-0">
                        <Image
                            src={item.icon}
                            alt="icon"
                            width={70}
                            height={70}
                            class="w-[50px] h-[50px] sm:w-[70px] sm:h-[70px] shrink-0 sm:mb-5"
                        />
                        <p class="text-sm sm:text-base leading-[1.4] sm:leading-[26px] text-soft tracking-text m-0">
                            {item[`text_${lang}` as const]}
                        </p>
                    </div>
                ))
            }
        </div>
    </Container>
</Section>
