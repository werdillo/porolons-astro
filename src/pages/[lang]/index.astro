---
import { Layout, homeSeo } from "#/app/layout";
import { Navbar } from "#/app/frame";
import { Hero, heroImage } from "#/company/hero";
import { Advances } from "#/company/advances";
import { Production } from "#/company/production";
import { AccordionSection } from "#/company/faq";
import { Location } from "#/company/location";
import type { Language } from "#/features/i18n";

const lang = Astro.params.lang as Language;

export function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "ru" } }];
}
---

<Layout lang={lang} title={homeSeo.title[lang]} description={homeSeo.description[lang]} image={heroImage}>
    <Navbar slot="header" lang={lang} />
    <Hero lang={lang} />
    <Advances lang={lang} />
    <Production lang={lang} />
    <AccordionSection lang={lang} />
    <Location slot="footer" lang={lang} />
</Layout>
